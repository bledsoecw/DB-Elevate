# ---------------------------------------------------------------------------
# DB Elevate - environment configuration
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# Database -------------------------------------------------------------------
# PostgreSQL. DB Elevate no longer runs on SQLite: it relies on
# case-insensitive matching that SQLite does not implement, and stores
# uploaded files as bytes. Development and production use the same engine
# deliberately — the difference between them was a real, silent bug.
#
# The easiest development database is a free Neon branch, with nothing to
# install: neon.tech -> your project -> Branches -> New branch -> copy the
# connection string. A local Postgres works equally well.
#
# DATABASE_URL is the POOLED connection, used by the application.
# DIRECT_URL is the UNPOOLED one, used only by `prisma migrate`.
# With a plain local Postgres, set both to the same value.
DATABASE_URL="postgresql://user:password@host/db_elevate?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db_elevate?sslmode=require"

# Where uploaded files live: "database" (default, and required on a serverless
# host, which has no writable disk that survives a request) or "filesystem"
# for a self-hosted installation with a real disk.
STORAGE_DRIVER="database"

# Sessions -------------------------------------------------------------------
# Reserved for signed artefacts (password reset tokens, export links).
# Generate with: openssl rand -base64 48
SESSION_SECRET="change-me-to-a-long-random-string"

# Application ----------------------------------------------------------------
APP_URL="http://localhost:3000"
# Overrides the seeded product name on first seed only; afterwards it is
# edited in Administration -> Branding.
# APP_PRODUCT_NAME="DB Elevate"

# Private file storage -------------------------------------------------------
# Attachments are written here and served only through an authorized route.
# Never point this inside ./public.
STORAGE_DIR="./storage/attachments"

# Development conveniences ---------------------------------------------------
# Shows the one-click demo account panel on the sign-in page. It still performs
# a real password sign-in; it does not bypass authentication. Ignored entirely
# when NODE_ENV=production.
ENABLE_DEV_LOGIN="true"
# Password applied to every seeded demo account.
SEED_PASSWORD="ElevateDemo!2026"

# Optional AI assistance -----------------------------------------------------
# The application is fully functional with AI disabled, which is the default,
# and no feature depends on it. The provider, the model and the monthly budget
# are chosen in Administration -> AI assistance, not here.
#
# Four things must be true at once before a paid model is ever called:
#   1. a provider chosen in Administration -> AI assistance
#   2. the switch there turned on
#   3. a monthly call budget above zero
#   4. the two server-side values below
#
# AI_BILLING_APPROVED is a deliberate sign-off that somebody with authority has
# approved the spend. Without it the application refuses to enable a paid
# provider at all, including against a direct API call, so nobody can start a
# metered service from a browser toggle. The "mock" provider needs none of
# this: it returns deterministic local fixtures, makes no network call, and
# costs nothing.
# AI_BILLING_APPROVED="false"
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT=""

# E-mail ---------------------------------------------------------------------
# Delivery is chosen in Administration -> Organization, but it cannot leave
# "outbox" unless EMAIL_TRANSPORT_CONFIGURED is true here. Both are required:
# the setting says what the organization wants, this says what the server is
# allowed to do. That is what stops a development or demonstration install
# mailing a real employee even if somebody changes the setting.
#
# With it unset (the default) every message is written to the outbox and read
# at /admin/outbox, and is reported as held rather than sent — nothing claims a
# delivery that did not happen.
# EMAIL_TRANSPORT_CONFIGURED="false"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# Scheduled jobs -------------------------------------------------------------
# Reminders, survey open/close and e-mail delivery run from:
#   npm run jobs:run              (every 15 minutes or so, from cron)
#   npm run jobs:dry-run          (no e-mail delivery)
# Safe to run as often as you like: reminders carry day-bucketed idempotency
# keys enforced by a unique index, and stored jobs are claimed with a
# conditional update, so overlapping runs cannot double-send.
#
# JOBS_TOKEN additionally enables POST /api/jobs/run for platforms that offer a
# cron-style webhook instead of a shell. Leave it blank and that route returns
# 404 rather than advertising that it exists. Generate with:
#   openssl rand -hex 32
JOBS_TOKEN=""

# --- Google Workspace single sign-on -----------------------------------
# Leave GOOGLE_CLIENT_ID empty and the application uses password sign-in only.
#
# Set all three and sign-in is restricted to the named Workspace domain, and
# password sign-in is REFUSED BY THE SERVER unless ALLOW_PASSWORD_LOGIN=true.
# See docs/SSO.md for the Google Cloud Console steps.
#
# The client secret is a secret: keep it out of source control and out of any
# client bundle. This file is a template; the real values belong in the
# deployment's environment, and .env is gitignored.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated. An ID token must carry an `hd` claim matching one of these
# AND an address in the same domain. Without this, SSO stays off rather than
# accepting any Google account.
GOOGLE_WORKSPACE_DOMAIN=""

# Only if the callback is not <APP_URL>/api/auth/sso/callback.
SSO_REDIRECT_URI=""

# "true" creates an account on first sign-in for anyone in the domain. Off by
# default: this application holds salary and review records, and every shared
# mailbox and service account in a Workspace would otherwise get in.
SSO_AUTO_PROVISION="false"

# "true" keeps password sign-in working alongside SSO. Anything else, including
# unset, turns it off once SSO is configured.
ALLOW_PASSWORD_LOGIN=""
